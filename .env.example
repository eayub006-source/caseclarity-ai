# CaseClarity AI — environment variables

# Required: PostgreSQL connection string (used by the app AND by `npm run db:push`)
DATABASE_URL=postgresql://postgres:postgres@127.0.0.1:5432/app_db

# Demo account (demo@caseclarity.ai / demo1234) and fictional seed data.
#   true  -> enabled (set this on the judges' demo deployment)
#   false -> disabled
#   unset -> enabled in development, DISABLED in production
DEMO_ACCOUNT=true

# Set to true ONLY when the app runs behind a proxy that sets X-Forwarded-For /
# X-Real-IP itself (Vercel, nginx, a load balancer). RECOMMENDED in production:
# an attacker's own IP is then blocked after 10 failed logins, long before the
# per-account cap (30 failures / 15 min, always on) could lock the real user out.
TRUST_PROXY=
# Which header your proxy OVERWRITES with the client IP (no fallback):
#   Vercel: x-vercel-forwarded-for   Cloudflare: cf-connecting-ip
#   nginx:  x-real-ip (proxy_set_header X-Real-IP $remote_addr)
#           or x-forwarded-for (proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for; right-most hop is used)
TRUSTED_IP_HEADER=x-forwarded-for

# Optional: real LLM analysis (OpenAI-compatible chat completions API).
# If LLM_API_KEY is not set, /api/analyze reports mode "demo" and the UI
# falls back to the local demo engine — clearly labeled in the UI and audit.
LLM_API_KEY=
# Optional overrides (defaults shown):
LLM_BASE_URL=https://api.openai.com/v1
LLM_MODEL=gpt-4o-mini
