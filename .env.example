# CaseClarity AI — environment variables (all optional).
#
# Case data has no database: the fictional demo data lives in
# src/data/demo-data.ts and each visitor's changes are saved in their own
# browser. AI document summaries are also mirrored to Cloudflare D1 (binding
# "DB", configured in cloudflare.config.ts, not here); without that binding
# they simply stay in the browser.
#
# Optional Live AI analysis (OpenAI-compatible chat completions API).
# Without LLM_API_KEY the app runs in Demo Mode with a transparent,
# deterministic engine, clearly labelled in the UI and the audit trail.
#
# - `npm run dev` (Next.js) reads this file: copy it to .env.
# - The Cloudflare Worker reads secrets instead: see .dev.vars.example and
#   cloudflare.config.ts.
LLM_API_KEY=
LLM_BASE_URL=https://api.openai.com/v1
LLM_MODEL=gpt-4o-mini
# Request timeout in milliseconds (5000–300000). Default: 90000 (90 s).
LLM_TIMEOUT_MS=90000
# Comma-separated fallback models, tried in order when the primary model is
# unavailable (e.g. a transient HTTP 503). Empty uses the built-in default
# (gemini-3.5-flash-lite). A fallback result is labelled in the audit trail.
LLM_FALLBACK_MODELS=
# Bounded retries: total HTTP attempts shared across the model chain (1–5).
# Transient 429/500/502/503/504 and timeouts are retried with exponential
# backoff; 401/403 are never retried.
LLM_MAX_ATTEMPTS=3
# Base delay for exponential backoff between attempts, in ms (0–30000).
LLM_RETRY_BASE_DELAY_MS=1000
