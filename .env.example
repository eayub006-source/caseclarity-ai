# CaseClarity AI — environment variables (all optional).
#
# There is no database: the fictional demo data lives in src/data/demo-data.ts
# and each visitor's changes are saved in their own browser.
#
# Optional Live AI analysis (OpenAI-compatible chat completions API).
# Without LLM_API_KEY the app runs in Demo Mode with a transparent,
# deterministic engine, clearly labelled in the UI and the audit trail.
#
# - `npm run dev` (Next.js) reads this file: copy it to .env.
# - The Cloudflare Worker reads secrets instead: see .dev.vars.example and
#   cloudflare.config.ts.
LLM_API_KEY=
LLM_BASE_URL=https://api.openai.com/v1
LLM_MODEL=gpt-4o-mini
