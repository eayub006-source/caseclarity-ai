# Copy to .env to run the app against the mock OpenAI-compatible provider in
# tests/mock-openai-server.mjs (start it with: node tests/mock-openai-server.mjs 4010).
#
# This is a TEST DOUBLE, not a real model. Use a real key and provider for
# production. Never commit .env.
LLM_API_KEY=test-key
LLM_BASE_URL=http://127.0.0.1:4010/v1
LLM_MODEL=mock-llm
LLM_TIMEOUT_MS=3000
# Exercises the fallback chain: the mock answers for any model name, so a
# primary-model failure falls through to this one.
LLM_FALLBACK_MODELS=fallback-mock
# Keep the scripted scenario run fast.
LLM_RETRY_BASE_DELAY_MS=10
